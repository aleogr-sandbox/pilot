{
  "$schema": "https://raw.githubusercontent.com/aleogr/aleogr/main/.claude-plugin/schemas/project.schema.json",
  "version": 1,
  "name": "pilot",
  "repo": {
    "provider": "github",
    "owner": "aleogr-sandbox",
    "name": "pilot",
    "visibility": "public",
    "description": "Reference project of aleogr: status pages per tenant",
    "topics": ["demo", "go", "reference", "status-page"],
    "settings": {
      "mergeCommit": true,
      "squash": true,
      "rebase": false,
      "deleteBranchOnMerge": true,
      "issues": true,
      "wiki": false,
      "projects": false
    }
  },
  "components": [
    { "name": "admin", "stack": "go", "path": "admin", "version": "1.27", "database": true },
    { "name": "status", "stack": "go", "path": "status", "version": "1.27", "database": true }
  ],
  "cloud": { "provider": "gcp", "region": "us-central1", "root": "tst" },
  "environments": { "dev": {} }
}
